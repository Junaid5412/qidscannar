# QID Bridge - send every request that is not a real file to bridge.php so the
# mobile app can keep using its normal /api/... paths unchanged.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # No RewriteBase on purpose: a relative target resolves against whichever
    # folder this .htaccess sits in, so the bridge works at the domain root, at
    # /qidbridge, or anywhere else without being edited.

    # Real files (bridge.php itself) are served directly.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ bridge.php [QSA,L]
</IfModule>

# The Authorization header carries the app's login token; some hosts drop it.
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Configuration and queue are never served over the web.
<FilesMatch "^(bridge_config|bridge_config\.sample)\.php$">
    Require all denied
</FilesMatch>
